import pgzrun

WIDTH = 600
HEIGHT = 600

names = ["mercury", "venus", "earth", "mars", "jupiter", "saturn", "uranus", "neptune"]
spots = [(500, 450), (100, 500), (300, 150), (450, 100), (150, 300), (500, 280), (300, 450), (80, 120)]

planets = []
for i in range(8):
    p = Actor(names[i])
    p.pos = spots[i]
    planets.append(p)

number = 0
words = "click the planet closest to the sun"

def draw():
    screen.fill("black")
    for p in planets:
        p.draw()
    screen.draw.text(words, (10, 10), color="white")

def on_mouse_down(pos):
    global number, words
    if number == 8:
        return
    if planets[number].collidepoint(pos):
        number = number + 1
        words = "you win" if number == 8 else "yes"
    else:
        words = "no"

pgzrun.go()