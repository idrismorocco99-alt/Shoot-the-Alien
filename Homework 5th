
import pgzrun
import random

WIDTH = 600
HEIGHT = 600

TITLE = "Shoot the Basketball"

basketball = Actor("basketball")
hoop = Actor("hoop")

message = " "
r, g, b = 17, 68, 214

score = 0


def draw():
    screen.clear()
    screen.fill((r, g, b))

    hoop.draw()
    basketball.draw()

    screen.draw.text("Score: " + str(score), (20, 20), color="gold")
    screen.draw.text(message, (200, 20), color="gold")


def on_mouse_down(pos):
    global message, r, g, b, score

    if basketball.collidepoint(pos):

        score = score + 1

        r = random.randint(0, 255)
        g = random.randint(0, 255)
        b = random.randint(0, 255)

        message = "Good Shot!"

        move_basketball()

    else:
        message = "Miss!"


def move_basketball():
    basketball.x = random.randint(50, 550)
    basketball.y = random.randint(100, 500)


move_basketball()

pgzrun.go()
